#!/bin/sh
# Post-installation script for the nwarp .deb package.
set -e

if ! id -u nwarp >/dev/null 2>&1; then
  useradd --system --no-create-home --shell /usr/sbin/nologin nwarp
fi

mkdir -p /var/log/nwarp /var/www/nwarp-default
chown -R nwarp:nwarp /etc/nwarp /var/log/nwarp /var/www/nwarp-default 2>/dev/null || true

systemctl daemon-reload || true

echo ""
echo "NWarp installed. Next steps:"
echo "  sudo systemctl enable --now nwarp"
echo "  sudo systemctl status nwarp"
echo "Config: /etc/nwarp/nwarp.conf"

exit 0

